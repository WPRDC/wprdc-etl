# Copy to .env for local dev.  (production notes at the bottom)

# --- environment / safety ---
# Publishing to CKAN happens ONLY when this is exactly "production". Any other
# value (or unset) forces a dry-run: output is written to a local folder and
# CKAN is never touched. This is the main guardrail — leave it unset for dev.
# ENVIRONMENT=production
# WPRDC_ETL_SINK_DIR=./_dryrun     # optional: where dry-run output goes (default _dryrun/)

# --- S3 landing zone (LocalStack for dev) ---
S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
LANDING_BUCKET=wprdc-etl-landing
# Outside production, writing to REAL AWS S3 (no S3_ENDPOINT_URL) is refused.
# Set this only if you deliberately want to land into a real dev bucket.
# WPRDC_ALLOW_REAL_S3=1

# --- asset IO manager (asset-to-asset DataFrame handoff) ---
# Unset  -> local filesystem manager (fine for dev; today's default).
# =s3    -> S3 pickle IO manager. Auto-selected when ENVIRONMENT=production.
#           To exercise the prod path locally against LocalStack, also set
#           AWS_S3_ADDRESSING_STYLE=path and (optionally) create the bucket:
#             aws --endpoint-url http://localhost:4566 s3 mb s3://wprdc-dagster-runtime
# =fs    -> force the filesystem manager even in production.
# WPRDC_IO_MANAGER=s3
# AWS_S3_ADDRESSING_STYLE=path
# DAGSTER_RUNTIME_BUCKET=wprdc-dagster-runtime   # prod: IO pickles + compute logs
# DAGSTER_IO_PREFIX=dagster/io                   # key prefix within that bucket

# --- SFTP test source (matches the compose `sftp` service) ---
# Value is "user:password"; referenced by a source's secret_ref.
WPRDC_LOCAL_SFTP=wprdc:wprdc

# --- per-publisher SFTP servers ---
# A source's host/port resolve from these, so real hostnames stay out of the
# repo. One set per publisher, shared by all of that publisher's SFTP datasets
# (the per-dataset `path` stays in its defs.yaml). Unset -> host resolves to ""
# and the run fails loudly in `landed` rather than connecting to nothing.
#
# Point at the compose sftp service for local dev, or at an `ssh -L` tunnel when
# the real server is only reachable through a jump host:
#
#   ssh -N -L 2223:<the-real-host>:22 you@jump-host
#
# ALLEGHENY_SFTP_HOST=localhost
# ALLEGHENY_SFTP_PORT=2223

# --- CKAN target ---
# Reached when ENVIRONMENT=production, OR when WPRDC_CKAN_WRITE=1 opts in to
# publishing against a LOCAL CKAN (below). Otherwise publish steps write to
# _dryrun/ and CKAN is never called.
CKAN_URL=http://localhost:5001
# Token for CKAN_URL above — the portal this repo WRITES to. It is sent only
# to that host: `bin/gis` reads publish targets from production by default,
# and shipping a localhost credential there would be a leak. Use
# CKAN_READ_TOKEN for a different portal.
CKAN_API_TOKEN=
# Read-only token for a portal that ISN'T CKAN_URL — i.e. what `bin/gis
# --ckan` talks to. Only needed to resolve targets in a PRIVATE package;
# public ones read fine anonymously.
# CKAN_READ_TOKEN=

# --- testing a job end to end against a local CKAN ---
# Pull from the real source, publish to your own CKAN. This unlocks CKAN calls
# and NOTHING else: the S3 landing still needs LocalStack (S3_ENDPOINT_URL), the
# spatial store still refuses a remote host, and the IO manager / alert sensor
# stay in their dev configuration — all of those key off ENVIRONMENT, which
# stays unset.
#
# Publishing to a non-local CKAN_URL is refused, so this cannot reach
# data.wprdc.org by leaving CKAN_URL at its default.
# WPRDC_CKAN_WRITE=1
# WPRDC_ALLOW_REMOTE_CKAN=1        # only for a real staging portal, deliberately

# --- Dagster storage (optional; only when DAGSTER_HOME points at dagster.yaml) ---
# Dev: the compose `postgres` service. Prod: your managed Postgres.
# Leave DAGSTER_HOME unset for quick local runs -> SQLite, and this is ignored.
DAGSTER_PG_URL=postgresql://dagster:dagster@localhost:5432/dagster

# --- Admin-region store (PostGIS) ---
# Backs the reverse_geocode transform op and the region_layer pipelines. Dev: the
# compose `postgis` service, a SEPARATE server from Dagster's (see dev/README.md).
# POSTGIS_PORT drives BOTH the compose port mapping and the DSN below — .env
# expands ${POSTGIS_PORT}, so change it in one place. Default 5434; 5433 is
# avoided because other local Postgres containers (e.g. a dockerized CKAN's
# database) commonly take it.
# Prod: the `spatial` database on the managed instance, postgis extension
# enabled. Unset is fine until a dataset actually uses reverse_geocode.
# Writes to a non-local host outside production are refused unless
# WPRDC_ALLOW_REMOTE_SPATIAL=1.
POSTGIS_PORT=5434
SPATIAL_DSN=postgresql://dagster:dagster@localhost:${POSTGIS_PORT}/spatial

# --- per-dataset source secrets (add as needed) ---
# ALLEGHENY_SFTP=user:password

# ---------------------------------------------------------------------------
# PRODUCTION (real S3 on AWS + live CKAN)
#
# All of the below are injected at deploy time (AWS Secrets Manager / SSM ->
# container env). NEVER commit a populated .env.
#
#   ENVIRONMENT=production          # without it, everything dry-runs
#   AWS_REGION=us-east-1            # NO S3_ENDPOINT_URL / AWS_* keys — use the IAM role
#   LANDING_BUCKET=wprdc-etl-landing
#   DAGSTER_RUNTIME_BUCKET=wprdc-dagster-runtime   # IO pickles + S3 compute logs
#   CKAN_URL=https://data.wprdc.org
#   CKAN_API_TOKEN=...               # dedicated least-privilege service token
#   ALLEGHENY_SFTP=user:password   # one per source secret_ref
#
#   # Dagster instance (DAGSTER_HOME must hold deploy/prod/dagster.yaml):
#   DAGSTER_HOME=/opt/dagster/home
#   DAGSTER_PG_URL=postgresql://user:pass@managed-host:5432/dagster?sslmode=require
#   SPATIAL_DSN=postgresql://user:pass@managed-host:5432/spatial?sslmode=require
#   DAGSTER_MAX_CONCURRENT_RUNS=4  # run-queue cap; tune without a redeploy
#
#   # Run-failure alerting (Slack):
#   DAGSTER_SLACK_BOT_TOKEN=xoxb-...              # chat:write, app in the channel
#   WPRDC_ALERT_SLACK_CHANNEL=#wprdc-etl-alerts
#   DAGSTER_WEBSERVER_URL=https://dagster.example.org   # deep links in alerts
#
# First prod boot and every `dagster` version bump: run `dagster instance
# migrate` before starting the webserver / daemon.
# ---------------------------------------------------------------------------
