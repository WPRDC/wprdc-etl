# Everything host-specific comes from the proxy container's environment
# (deploy/compose.prod.yaml): DAGSTER_DOMAIN from deploy.env, the credentials
# from /opt/wprdc-etl/proxy.env. Generate the hash with `caddy hash-password`
# and single-quote it in proxy.env — it is full of `$`.
{$DAGSTER_DOMAIN} {
	encode gzip
	basic_auth {
		{$DAGSTER_UI_USER} {$DAGSTER_UI_PASSWORD_HASH}
	}
	reverse_proxy webserver:3000
}
